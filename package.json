{
  "name": "eaangrino-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "check:seo": "node scripts/check-seo-indexability.mjs",
    "validate": "pnpm lint && pnpm test && pnpm build && pnpm check:seo",
    "deploy": "gh-pages -d out -b gh-pages --nojekyll",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "next": "16.3.5",
    "next-intl": "4.14.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "daisyui": "5.6.15",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "gh-pages": "6.3.0",
    "jest": "30.5.1",
    "jest-environment-jsdom": "30.5.1",
    "postcss": "8.5.23",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  }
}
